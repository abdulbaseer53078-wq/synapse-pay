{
  "title": "Financial core",
  "uid": "financial-core",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ledger imbalance (must be 0)",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(abs(synapse_ledger_imbalance_paise))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unbalanced entries, last day (must be 0)",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(synapse_ledger_unbalanced_entries)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ledger protections disabled (must be 0)",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (trigger) (synapse_ledger_protection_disabled))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Money posted per hour, by entry type (\u20b9)",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (entry_type) (increase(synapse_ledger_posted_paise_total[1h])) / 100",
          "legendFormat": "{{entry_type}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Payments stuck over 5 minutes (must stay under 5)",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (kind) (synapse_stuck_transactions_current)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Chargebacks opened per day",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(synapse_chargebacks_total[24h]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Chargebacks by status",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (synapse_chargebacks_total)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Refused ledger writes (must be 0)",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(synapse_ledger_imbalance_total[1h]))",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
